# API origin, e.g. http://localhost:8000 (a trailing /api is also accepted).
VITE_API_BASE_URL=http://localhost:8000

# Optional Laravel Reverb / Echo
# VITE_REVERB_APP_KEY=local-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http

# Optional: Google Maps Embed / JavaScript API key (restrict it to your domain).
# Without it, schools show an "Open in Google Maps" link instead of a map.
# VITE_GOOGLE_MAPS_API_KEY=
