# DriveQ web front (DIQ-1301, DIQ-1302).
# SITE_ADDRESS is the public domain ("driveq.in, www.driveq.in"): Caddy then
# gets and renews HTTPS certificates by itself. Use ":80" for a local test.
{
	email {$ACME_EMAIL:admin@example.com}
	servers {
		# Set TRUSTED_PROXY_RANGES when a CDN or load balancer sits in front.
		trusted_proxies static {$TRUSTED_PROXY_RANGES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		# Report-only for the first week; enforce once no violations show up.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://maps.googleapis.com wss:; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API and Laravel's own endpoints go to PHP-FPM. REQUEST_URI keeps the
	# original path, so Laravel routes it as usual.
	@laravel path /api/* /up /broadcasting/* /sitemap.xml
	handle @laravel {
		rewrite * /index.php
		reverse_proxy {$APP_UPSTREAM:app:9000} {
			transport fastcgi {
				root /var/www/html/public
				split .php
			}
		}
	}

	# Hashed build assets never change: cache them for a year. A missing one
	# is a plain 404, never the app shell (that would be cached for a year).
	handle /assets/* {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path is a page of the React app.
	handle {
		root * /srv/www
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
