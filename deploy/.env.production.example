# DriveQ production settings (DIQ-1301). Copy to .env.production on the
# server (never commit it) and fill in every value marked REQUIRED.
# Used by docker-compose.prod.yaml for both compose itself and the app.

# ── Site ────────────────────────────────────────────────────────────────
APP_NAME=DriveQ
# REQUIRED: generate with
#   docker compose -f docker-compose.prod.yaml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# REQUIRED: the public address, with https.
APP_URL=https://driveq.in
FRONTEND_URL=https://driveq.in
# Caddy serves these names and fetches HTTPS certificates for them.
SITE_ADDRESS=driveq.in, www.driveq.in
ACME_EMAIL=you@example.com
SCHEDULE_TIMEZONE=Asia/Kolkata
LOG_LEVEL=warning

# ── Database (also creates the Postgres user) ───────────────────────────
DB_DATABASE=driveq
DB_USERNAME=driveq
# REQUIRED: a long random password (openssl rand -base64 32)
DB_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────
SANCTUM_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=driveq.in,www.driveq.in
BCRYPT_ROUNDS=12

# ── Proxies (DIQ-1302) ──────────────────────────────────────────────────
# Leave empty when browsers reach Caddy directly (the default setup).
# Behind Cloudflare or an AWS load balancer, list their IP ranges (comma
# separated) in both variables so rate limits use the visitor's real IP.
TRUSTED_PROXIES=
TRUSTED_PROXY_RANGES=127.0.0.1/32

# ── Files ───────────────────────────────────────────────────────────────
# Documents stay on the server's app_storage volume (backed up nightly).
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local

# ── Mail (REQUIRED before launch) ───────────────────────────────────────
# Transactional mail: password reset, invites, lead alerts, review links.
# Amazon SES in ap-south-1 works well with AWS hosting.
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@driveq.in
MAIL_FROM_NAME=DriveQ

# Outreach to schools goes from its own subdomain so it can't hurt the
# main sender's reputation. Leave OUTREACH_MAILER=log until DNS is ready.
OUTREACH_MAILER=log
OUTREACH_MAIL_HOST=
OUTREACH_MAIL_PORT=587
OUTREACH_MAIL_USERNAME=
OUTREACH_MAIL_PASSWORD=
OUTREACH_FROM_ADDRESS=team@hello.driveq.in
OUTREACH_FROM_NAME=DriveQ
OUTREACH_REPLY_TO=
OUTREACH_POSTAL_ADDRESS=
OUTREACH_DAILY_CAP=150

# ── WhatsApp / SMS ──────────────────────────────────────────────────────
# "log" records messages without sending. Keep it until a provider is set.
MESSAGING_DRIVER=log

# ── Google (optional for the pilot) ─────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_ADS_WEBHOOK_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Plans and billing ───────────────────────────────────────────────────
PLAN_TRIAL_DAYS=30
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_GSTIN=
BILLING_EMAIL=billing@driveq.in
BILLING_UPI_ID=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_NAME=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_IFSC=

# ── Data retention (DPDP) ───────────────────────────────────────────────
# false = report only. Turn on after reviewing a dry run.
RETENTION_EXECUTE=false

# ── Backups (deploy/backup.sh) ──────────────────────────────────────────
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=driveq
AWS_DEFAULT_REGION=ap-south-1
