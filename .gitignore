# ==============================================================================
# DriveIQ Driving School Marketplace - Unified Root Gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# System & General Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
.cursor/
.zed/
.nova/
.replit
.replitignore
.replit.md
.project
.classpath
.c9/
.settings/
*.launch
*.sublime-workspace
*.sublime-project
*.code-workspace

# ------------------------------------------------------------------------------
# Environment, Secrets, and Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.docker.example
*.key
auth.json

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
vendor/
.pnpm-store/
.pnpm-debug.log
yarn-error.log
npm-debug.log
package-lock.json
yarn.lock

# ------------------------------------------------------------------------------
# Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
libpeerconnection.log
testem.log

# ------------------------------------------------------------------------------
# PHP / Laravel Specific (backend/)
# ------------------------------------------------------------------------------
backend/.phpactor.json
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/storage/*.key
backend/storage/pail/
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/storage/framework/testing/
backend/public/build/
backend/public/hot/
backend/public/storage
backend/public/fonts-manifest.dev.json
backend/_ide_helper.php
backend/_ide_helper_models.php
backend/.php_cs.cache
Homestead.json
Homestead.yaml

# ------------------------------------------------------------------------------
# Node.js / React / TypeScript Specific (frontend/)
# ------------------------------------------------------------------------------
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/coverage/
frontend/typings/
frontend/.expo/
frontend/.expo-shared/
frontend/.cache/
frontend/.local/
frontend/.sass-cache/
frontend/connect.lock
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Testing & Quality Tools
# ------------------------------------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.replit/
.cache/
.local/

frontend_old/