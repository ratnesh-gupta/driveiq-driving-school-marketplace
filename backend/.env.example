# ---------------------------------------------------------------------------
# PRODUCTION CHECKLIST (BSEC-16). With APP_ENV=production the app REFUSES TO BOOT
# unless all of these hold (App\Support\ProductionGuard):
#   APP_DEBUG=false          APP_KEY set (php artisan key:generate --show)
#   DB_CONNECTION=pgsql      MAIL_MAILER not log/array (smtp, ses, ...)
#   MESSAGING_DRIVER not unset/log while MESSAGING_REQUIRE_REAL=true (a real
#     provider driver, or "null" to send nothing)
#   FRONTEND_URL / CORS_ALLOWED_ORIGINS are exact origins, no wildcard
#   GOOGLE_ADS_WEBHOOK_KEY, if set, is at least 32 characters
# Also set for production (all PHP services web/worker/scheduler share one env):
#   APP_URL (https; feeds signed e-mail links + Google OAuth redirect),
#   TRUSTED_PROXIES, SANCTUM_STATEFUL_DOMAINS, QUEUE_CONNECTION=redis,
#   CACHE_STORE=redis, SESSION_DRIVER=redis, REDIS_*, DOCUMENTS_DISK (private,
#   encrypted S3/Spaces), AWS_*, MAIL_*, OUTREACH_*, BILLING_*, LOG_CHANNEL=stderr,
#   LOG_LEVEL=warning, DOCUMENTS_ENCRYPT=true.
# ---------------------------------------------------------------------------
APP_NAME=DriveQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS only (migrations need them; sqlite will not run). In
# docker-compose use DB_HOST=postgres. Production: use a dedicated app role.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=driveiq
DB_USERNAME=driveiq
DB_PASSWORD=driveiq
# DB_SSLMODE=require   # managed Postgres

# production: redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SPA origin for Sanctum / CORS / e-mail links
FRONTEND_URL=http://localhost:5173
# Optional comma list of exact allowed origins; defaults to FRONTEND_URL. No "*".
CORS_ALLOWED_ORIGINS=

# Reverse proxies allowed to set X-Forwarded-For/Proto (BSEC-02). Comma list of IPs/CIDRs.
# Empty = trust nobody (correct for local dev and when the app is exposed directly).
# Behind nginx/Cloudflare set the proxy network, e.g. 172.18.0.0/16 or the LB IP.
# "*" trusts every hop: ONLY use it when the origin port is firewalled to the proxy,
# otherwise clients can spoof their IP and bypass every rate limit.
TRUSTED_PROXIES=
SANCTUM_EXPIRATION=10080
SANCTUM_ADMIN_EXPIRATION_HOURS=8
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# Phase 0.5: use "log" until Reverb is installed; then set BROADCAST_CONNECTION=reverb
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Private learner/instructor/vehicle documents (DIQ-601). "local" = storage/app/private; use an S3/Spaces disk in production.
DOCUMENTS_DISK=local
# BSEC-15: encrypt new private uploads at rest with APP_KEY (default true). Existing plain
# files stay readable until `php artisan driveiq:encrypt-documents --execute` converts them.
# Keep old keys in APP_PREVIOUS_KEYS when rotating APP_KEY or encrypted files become unreadable.
DOCUMENTS_ENCRYPT=true
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (optional)
# REVERB_APP_ID=driveiq
# REVERB_APP_KEY=local-key
# REVERB_APP_SECRET=local-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# Payments (optional live gateway)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# WhatsApp / SMS (DIQ-1001): log | null | a provider driver you register in config/messaging.php
MESSAGING_DRIVER=log
# Production only: true (default) = boot refuses MESSAGING_DRIVER unset/log (it writes
# one-time codes and lead names to logs). Set false only knowingly.
MESSAGING_REQUIRE_REAL=true
MESSAGING_SMS_FALLBACK=false

# production: smtp / ses / ... (log and array are refused at boot)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@driveiq.local"
MAIL_FROM_NAME="${APP_NAME}"

# School / trainer outreach (DIQ-1105). Keep OUTREACH_MAILER=log until the
# outreach mailbox (own subdomain, SPF/DKIM/DMARC) is set up; then "outreach".
OUTREACH_MAILER=log
OUTREACH_MAIL_HOST=smtp.gmail.com
OUTREACH_MAIL_PORT=587
OUTREACH_MAIL_USERNAME=
OUTREACH_MAIL_PASSWORD=
OUTREACH_FROM_ADDRESS="partners@hello.driveq.in"
OUTREACH_FROM_NAME="DriveQ Partnerships"
OUTREACH_REPLY_TO=
OUTREACH_POSTAL_ADDRESS="DriveQ, Pune, Maharashtra, India"
OUTREACH_DAILY_CAP=150
OUTREACH_START_HOUR=10
OUTREACH_END_HOUR=18

# Google Ads lead form webhook key (DIQ-1106); empty = webhook off
GOOGLE_ADS_WEBHOOK_KEY=

# Google Business Profile connect (DIQ-1107); empty = feature hidden.
# OAuth redirect URI to register: ${APP_URL}/api/google-business/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DPDP retention job (DIQ-606): the daily run only reports unless this is true.
RETENTION_EXECUTE=false
# Comma-separated school ids under legal hold (never purged).
RETENTION_LEGAL_HOLD_SCHOOLS=
# Retention windows in months (WP-8); see config/retention.php
# RETENTION_MONTHS_NOTIFICATIONS=6
# RETENTION_MONTHS_TRAINING_RECORDS=36
# RETENTION_MONTHS_ACCOUNTS_INACTIVE=36
# RETENTION_MONTHS_PAYMENTS=96

# Plans & billing (DIQ-802/803). Collection is manual: schools pay these
# details by UPI / bank transfer and an admin records the payment.
PLANS_ENFORCE=true
PLAN_TRIAL_DAYS=30
BILLING_GST_RATE=18
BILLING_DUE_DAYS=7
BILLING_SELLER_NAME="DriveQ"
BILLING_SELLER_ADDRESS="Pune, Maharashtra, India"
BILLING_GSTIN=
BILLING_EMAIL=billing@driveq.in
BILLING_UPI_ID=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_NAME=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_IFSC=
