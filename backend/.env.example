APP_NAME=DriveIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default sqlite; production MUST use pgsql
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=driveiq
# DB_USERNAME=driveiq
# DB_PASSWORD=driveiq

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SPA origin for Sanctum / CORS
FRONTEND_URL=http://localhost:5173
SANCTUM_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# Phase 0.5: use "log" until Reverb is installed; then set BROADCAST_CONNECTION=reverb
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Private learner/instructor/vehicle documents (DIQ-601). "local" = storage/app/private; use an S3/Spaces disk in production.
DOCUMENTS_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (optional)
# REVERB_APP_ID=driveiq
# REVERB_APP_KEY=local-key
# REVERB_APP_SECRET=local-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# Payments (optional live gateway)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@driveiq.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DPDP retention job (DIQ-606): the daily run only reports unless this is true.
RETENTION_EXECUTE=false
# Comma-separated school ids under legal hold (never purged).
RETENTION_LEGAL_HOLD_SCHOOLS=

# Plans & billing (DIQ-802/803). Collection is manual: schools pay these
# details by UPI / bank transfer and an admin records the payment.
PLANS_ENFORCE=true
PLAN_TRIAL_DAYS=30
BILLING_GST_RATE=18
BILLING_DUE_DAYS=7
BILLING_SELLER_NAME="DriveIQ"
BILLING_SELLER_ADDRESS="Pune, Maharashtra, India"
BILLING_GSTIN=
BILLING_EMAIL=billing@driveiq.in
BILLING_UPI_ID=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_NAME=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_IFSC=
